# =============================================================================
# MVR Founding Seat Landing Page — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# =============================================================================

# --- Supabase ---
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...  # anon/public key (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...      # service_role key (SERVER ONLY — never expose to browser)

# --- Database (Supabase Postgres) ---
# Found in: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "Transaction" pooler URL for DATABASE_URL (Prisma serverless queries)
# Use the "Direct" connection URL for DIRECT_URL (Prisma migrations)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- Stripe ---
# Found in: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=sk_test_...            # Secret key (SERVER ONLY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...  # Publishable key (safe to expose)

# Stripe webhook signing secret — obtained from Stripe CLI or Dashboard webhook endpoint
# For local dev: run `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# The CLI will output a signing secret like: whsec_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (Transactional Email) ---
# Found in: Resend Dashboard -> API Keys -> Create API Key
# Domain setup: Resend Dashboard -> Domains -> Add Domain -> follow DNS setup wizard
RESEND_API_KEY=re_xxxxxxxxxxxx
